{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "rootDir": "public/ts",
    "outDir": "public/js",
    "strict": true,
    "noImplicitAny": true,
    "removeComments": false,
    "sourceMap": false
  },
  "include": ["public/ts/**/*.ts"]
}
